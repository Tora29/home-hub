{
	"name": "home-hub",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.10.0"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:cf": "npm run build && wrangler pages dev .svelte-kit/cloudflare",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --cache && eslint . --cache",
		"format": "prettier --write . --cache",
		"test:unit": "vitest",
		"test:integration": "TZ=UTC vitest --config vitest.integration.config.ts",
		"test": "npm run test:unit -- --run && npm run test:integration -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply home-hub --local",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260928.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0",
		"better-auth": "^1.5.5",
		"drizzle-orm": "^0.45.3",
		"zod": "^4.3.6"
	},
	"overrides": {
		"@cloudflare/vitest-pool-workers": {
			"sharp": "0.35.4"
		}
	}
}
