{
	"name": "home-hub",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.10.0"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:cf": "npm run build && wrangler pages dev .svelte-kit/cloudflare",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --cache && eslint . --cache",
		"format": "prettier --write . --cache",
		"test:unit": "vitest",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"test": "npm run test:unit -- --run && npm run test:integration -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply home-hub --local",
		"db:studio": "drizzle-kit studio",
		"openapi:watch": "docker compose up swagger-ui"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260823.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"js-yaml": "^5.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.54.0",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.577.0",
		"better-auth": "^1.5.5",
		"drizzle-orm": "^0.45.1",
		"zod": "^4.3.6"
	}
}
